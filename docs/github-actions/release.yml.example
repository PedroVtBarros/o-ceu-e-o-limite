name: Windows desktop

on:
  workflow_dispatch:
    inputs:
      create_draft_release:
        description: "Criar rascunho de Release nesta tag, após todos os testes"
        type: boolean
        default: false
  push:
    tags:
      - "v*"

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest
    env:
      CSC_IDENTITY_AUTO_DISCOVERY: "false"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm run dist:win
      - run: npm run test:e2e
      - run: node scripts/verify-release.mjs
      - run: npm run test:release
      - uses: actions/upload-artifact@v4
        with:
          name: O-Ceu-e-o-Limite-Windows
          path: |
            release/*-Portatil.exe
            release/*-Instalador.exe
            release/SHA256SUMS.txt
            release/LEIA-ME.txt
            release/NOTAS-DA-VERSAO.md
            release/RECUPERACAO.md
            release/THIRD_PARTY_NOTICES.txt
            release/LICENSE.txt
          if-no-files-found: error
          retention-days: 30
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: Evidencias-Windows
          path: test-results/
          if-no-files-found: ignore

  draft-release:
    if: github.event_name == 'workflow_dispatch' && inputs.create_draft_release && startsWith(github.ref, 'refs/tags/')
    needs: build
    runs-on: windows-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: O-Ceu-e-o-Limite-Windows
          path: release
      - name: Conferir tag e criar rascunho
        shell: pwsh
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          $version = (Get-Content -LiteralPath package.json -Raw | ConvertFrom-Json).version
          if ($env:GITHUB_REF_NAME -ne "v$version") { throw 'A tag deve corresponder à versão do pacote.' }
          $assets = @("release/O-Ceu-e-o-Limite-$version-Windows-x64-Portatil.exe", "release/O-Ceu-e-o-Limite-$version-Windows-x64-Instalador.exe", 'release/SHA256SUMS.txt', 'release/LEIA-ME.txt', 'release/NOTAS-DA-VERSAO.md', 'release/RECUPERACAO.md', 'release/THIRD_PARTY_NOTICES.txt', 'release/LICENSE.txt')
          foreach ($asset in $assets) { if (-not (Test-Path -LiteralPath $asset -PathType Leaf)) { throw "Arquivo ausente: $asset" } }
          gh release create "$env:GITHUB_REF_NAME" @assets --draft --verify-tag --title "O Céu é o Limite $version" --notes-file release/NOTAS-DA-VERSAO.md
          if ($LASTEXITCODE -ne 0) { throw 'Não foi possível criar o rascunho; nenhum Release existente foi alterado.' }
